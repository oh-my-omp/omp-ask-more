{
	"name": "omp-ask-ng",
	"version": "0.3.1",
	"private": true,
	"type": "module",
	"description": "One ask for every user decision: questions with a brief, evidence and per-option tradeoffs, compiled into the host ask's form",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-ask-ng.git"
	},
	"files": [
		"index.ts",
		"src",
		"omomp-shared",
		"tern",
		"CHANGELOG.md"
	],
	"omomp": {
		"changelog": "CHANGELOG.md"
	},
	"omp": {
		"extensions": [
			"./index.ts"
		],
		"settings": {
			"readability.judge": {
				"type": "boolean",
				"default": true,
				"description": "When a judge model is available, reject asks it finds hard to understand so the agent rewrites them"
			}
		}
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"eval:readability": "bun eval/readability.ts"
	},
	"peerDependencies": {
		"@oh-my-pi/omptype": "*",
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/omptype": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-ai": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
